{
  "name": "soundvia",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript client for the soundvia.eu API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "soundvia",
    "music",
    "api",
    "sdk",
    "streaming"
  ],
  "author": "soundviadigital",
  "license": "MIT",
  "homepage": "https://github.com/soundviadigital/soundvia-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundviadigital/soundvia-js.git"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
